# local share path
SHARE_HOST_PATH=./share
# dafault mount path
SHARE_MOUNT_PATH=/mnt/share

DB_PATH=/data/app.db
SAMBA_SERVICE_USER=service-user
WORKGROUP=WORKGROUP
# host name for mount-scripts (//nas/<share> в linux, \\nas\<share> в windows)
NAS_HOST=nas
# SMB-port on host (compose.yml -> ${NAS_PORT:-1445}:445)
NAS_PORT=1445

JWT_SECRET=change-me-in-dev
JWT_TTL_MINUTES=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

EXPIRY_CHECK_INTERVAL_SECONDS=60
