# Путь-источник шар на хосте (bind-mount в контейнер)
SHARE_HOST_PATH=./share
# Корень шар внутри контейнера; все пути шар в БД относительные от него
SHARE_MOUNT_PATH=/mnt/share

DB_PATH=/data/app.db
SAMBA_SERVICE_USER=service-user
WORKGROUP=WORKGROUP
# Имя/адрес NAS-хоста для mount-скриптов (//nas/<share> в linux, \\nas\<share> в windows)
NAS_HOST=nas

JWT_SECRET=change-me-in-dev
JWT_TTL_MINUTES=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

EXPIRY_CHECK_INTERVAL_SECONDS=60
